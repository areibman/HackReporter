# Performance Optimization Configuration for HackReporter
# Copy these settings to your .env file for optimal performance

# ============================================
# CONCURRENCY & PARALLELISM
# ============================================
# Maximum number of videos to process concurrently
# Lower values use less memory but take longer
MAX_CONCURRENT_VIDEOS=3

# Batch size for processing videos
# Videos are processed in batches to manage memory
BATCH_SIZE=5

# Delay between batches (seconds)
# Helps avoid API rate limits
BATCH_DELAY=10

# Sequential processing mode
# Set to true for low-memory environments or API quota issues
SEQUENTIAL_VIDEO_PROCESSING=false

# ============================================
# API & NETWORK OPTIMIZATION
# ============================================
# Maximum retries for failed API calls
MAX_RETRIES=2

# Delay between retries (seconds)
RETRY_DELAY=5

# API rate limiting (requests per minute)
MAX_RPM=10

# Request timeout (seconds)
API_TIMEOUT=60

# ============================================
# VIDEO PROCESSING
# ============================================
# Maximum video file size (MB)
# Larger files will be skipped or need optimization
MAX_VIDEO_SIZE_MB=500

# Default frames per second for video analysis
# Lower values process faster but may miss details
DEFAULT_FPS=0.5

# Video processing timeout (seconds)
VIDEO_PROCESSING_TIMEOUT=120

# Enable video caching
# Caches analysis results for 24 hours
ENABLE_VIDEO_CACHE=true

# Cache directory
CACHE_DIR=.cache/video_analysis

# ============================================
# MEMORY MANAGEMENT
# ============================================
# Enable garbage collection after each video
FORCE_GC=true

# Memory limit warning threshold (MB)
MEMORY_WARNING_THRESHOLD=2000

# Memory limit error threshold (MB)
MEMORY_ERROR_THRESHOLD=4000

# ============================================
# CREW AI OPTIMIZATION
# ============================================
# Maximum iterations per agent
MAX_AGENT_ITERATIONS=3

# Enable agent memory (uses more RAM but improves context)
ENABLE_AGENT_MEMORY=false

# Share crew context between tasks
SHARE_CREW_CONTEXT=false

# Agent verbose mode (set to false for production)
VERBOSE=false

# ============================================
# PERFORMANCE MONITORING
# ============================================
# Enable debug mode with memory tracking
DEBUG_MODE=false

# Enable performance profiling
ENABLE_PROFILING=false

# Performance metrics output directory
METRICS_DIR=output/metrics

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# MODEL OPTIMIZATION
# ============================================
# Gemini model selection (gemini-2.0-flash is faster)
GEMINI_MODEL=gemini-2.0-flash

# Maximum output tokens (lower = faster)
MAX_OUTPUT_TOKENS=1000

# Temperature for generation (lower = more deterministic)
TEMPERATURE=0.7

# Top-p sampling
TOP_P=0.8

# ============================================
# OPTIMIZATION PRESETS
# ============================================
# Uncomment one preset below based on your needs:

# --- PRESET: FAST (Prioritize speed) ---
# MAX_CONCURRENT_VIDEOS=5
# BATCH_SIZE=10
# DEFAULT_FPS=0.25
# MAX_OUTPUT_TOKENS=500
# ENABLE_AGENT_MEMORY=false

# --- PRESET: BALANCED (Default) ---
# MAX_CONCURRENT_VIDEOS=3
# BATCH_SIZE=5
# DEFAULT_FPS=0.5
# MAX_OUTPUT_TOKENS=1000
# ENABLE_AGENT_MEMORY=false

# --- PRESET: QUALITY (Prioritize accuracy) ---
# MAX_CONCURRENT_VIDEOS=2
# BATCH_SIZE=3
# DEFAULT_FPS=1.0
# MAX_OUTPUT_TOKENS=2000
# ENABLE_AGENT_MEMORY=true

# --- PRESET: LOW_MEMORY (For limited RAM) ---
# MAX_CONCURRENT_VIDEOS=1
# SEQUENTIAL_VIDEO_PROCESSING=true
# BATCH_SIZE=1
# DEFAULT_FPS=0.25
# ENABLE_AGENT_MEMORY=false
# FORCE_GC=true